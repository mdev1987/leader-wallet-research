# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored and must never be committed.
#
# REQUIRED by the current src/ worker: BIRDEYE_API_KEY and HELIUS_API_KEY.
# The remaining keys are placeholders for optional/planned integrations
# (paper trading, alerts, enrichment) and are ignored by the current code.
# Example values below are starting points only — tune to your API plan.

BIRDEYE_API_KEY=your_birdeye_api_key

HELIUS_API_KEY=your_helius_api_key
HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key
HELIUS_TXS=
HELIUS_TX_HISTORY=

# Solana only for this strategy.
CHAIN=solana

# Free Standard package is documented at 1 request/sec.
# 1.5 spacing is used because a 5-minute live run showed Birdeye 429ing
# every second request at 1.15s (phase-locked just under its real window).
API_MIN_REQUEST_INTERVAL_SECONDS=1.5

# Discovery / polling.
DISCOVERY_INTERVAL_SECONDS=300
POLL_INTERVAL_SECONDS=30
CANDIDATE_LIMIT=100
MAX_WATCHED_TOKENS=5

# Early-token universe.
MIN_MARKET_CAP_USD=25000
MAX_MARKET_CAP_USD=10000000
MIN_LIQUIDITY_USD=25000
MAX_TOKEN_AGE_HOURS=72
# token_creation_info is Lite/Starter+, not free Standard. When it is
# inaccessible the age is "unknown": warn and continue unless AGE_STRICT=true.
ENFORCE_TOKEN_AGE=false
AGE_STRICT=false
MAX_PRICE_CHANGE_24H_PERCENT=500

# Smart-money proxy. Birdeye documents these Solana wallet_tags values:
# dev, bundler, sniper, insider, smart_trader.
TOP_TRADERS_LIMIT=20
SMART_TAGS=smart_trader
MIN_SMART_WALLETS=2
MIN_SMART_BUY_RATIO=0.6

# 15m CVD.
CVD_WINDOW_SECONDS=900
CVD_MIN_BUY_SELL_RATIO=1.2

# Paper-position lifecycle only.
STOP_LOSS_PERCENT=15
TAKE_PROFIT_PERCENT=50
MAX_HOLD_SECONDS=3600
# Consecutive bearish-CVD polls before a paper exit fires (whipsaw guard).
BEARISH_EXIT_CONFIRMATIONS=2

# Free keyless enrichment (own polite spacing, outside Birdeye CU budget).
DEXSCREENER_ENABLED=true
DEXSCREENER_MIN_REQUEST_INTERVAL_SECONDS=2
JUPITER_API_KEY=
JUPITER_ENABLED=false
JUPITER_MIN_REQUEST_INTERVAL_SECONDS=2

# RugCheck pre-entry veto (free summary endpoint).
RUGCHECK_API_KEY=
RUGCHECK_ENABLED=false
RUGCHECK_MAX_SCORE=50
RUGCHECK_REJECT_DANGER=true
RUGCHECK_STRICT=false
RUGCHECK_MIN_REQUEST_INTERVAL_SECONDS=2

# Optional CabalSpy cluster confirmation. Inert unless a key is set.
CABALSPY_API_KEY=
CABALSPY_ENABLED=false
CABALSPY_MIN_WALLETS=3
CABALSPY_REQUIRE_CLUSTER=false
CABALSPY_MIN_REQUEST_INTERVAL_SECONDS=2

# Helius RPC + transfers (holder concentration, on-chain buy proof).
# Inert unless HELIUS_API_KEY is set. Uses HELIUS_RPC_URL when present.
HELIUS_ENABLED=true
HELIUS_RPC_URL=
HELIUS_MIN_REQUEST_INTERVAL_SECONDS=1
HELIUS_TOP10_MAX_PCT=30
# HELIUS_REJECT_CONCENTRATION=false
HELIUS_REJECT_CONCENTRATION=false
HELIUS_VERIFY_WALLETS=true
# HELIUS_REQUIRE_CONFIRMED=false
HELIUS_REQUIRE_CONFIRMED=false
HELIUS_VERIFY_WINDOW_HOURS=24
HELIUS_VERIFY_LIMIT=100

#
SHYFT_API_KEY=
SHYFT_RPC_URL=
SHYFT_WS_URL=

# Telegram paper alerts (python-telegram-bot + telegramify-markdown).
# Inert unless BOTH are set.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paper portfolio: cash accounting behind open/close alerts.
PAPER_START_BALANCE_USD=1000
PAPER_POSITION_SIZE_USD=100
MAX_OPEN_POSITIONS=3


DBOTX_API_KEY=

# Wallet private key for any future live execution. Leave empty for
# research/paper mode. NEVER commit a real key.
PRIVATE_KEY=
