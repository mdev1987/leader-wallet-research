# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored and must never be committed.
#
# The research worker reads only these two keys. Birdeye prices event timing
# and discovery; Helius supplies event-local transactions. Everything else
# (DexScreener pair metadata for pool labeling) is keyless.

BIRDEYE_API_KEY=your_birdeye_api_key
HELIUS_API_KEY=your_helius_api_key
